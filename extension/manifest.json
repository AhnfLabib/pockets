{
  "manifest_version": 3,
  "name": "Pockets",
  "version": "0.1.0",
  "description": "A small character who takes your stale tabs.",
  "permissions": ["tabs", "storage", "alarms", "idle", "sessions", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
